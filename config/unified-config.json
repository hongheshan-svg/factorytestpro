{
  "ConfigurationInfo": {
    "Name": "Default Production Configuration",
    "Version": "1.0.0",
    "CreatedDate": "2026-07-15T00:00:00Z",
    "Description": "Default configuration for the Universal Test Framework",
    "Author": "UTF System"
  },
  "SystemSettings": {
    "LogLevel": "Info",
    "AutoSaveResults": true,
    "ResultsPath": "./test-results",
    "BackupEnabled": true,
    "MaxLogFiles": 10,
    "LogRotationSizeMB": 50,
    "DefaultLanguage": "zh-CN",
    "Theme": "Light",
    "AutoRefresh": true,
    "RefreshInterval": 2000
  },
  "DUTConfiguration": {
    "ProductInfo": {
      "Name": "Generic Device",
      "Model": "GENERIC-1.0",
      "Icon": "device",
      "Category": "Test Equipment",
      "ExpectedSoftwareVersion": "SW_VERSION:V1.0"
    },
    "GlobalSettings": {
      "DefaultMaxConcurrent": 16,
      "EnablePreTestCheck": true,
      "DefaultVoltage": 3.8,
      "DefaultCurrent": 0.5,
      "TestTimeout": 300,
      "RetryCount": 3,
      "RetryDelay": 2000
    },
    "CommunicationEndpoints": {
      "SerialPorts": ["COM3", "COM4", "COM5", "COM6"],
      "NetworkHosts": ["192.168.1.10", "192.168.1.11", "192.168.1.12", "192.168.1.13"]
    },
    "NamingConfig": {
      "Template": "{TypeName} Station {Index}",
      "IdTemplate": "DUT-{Index}"
    }
  },
  "TestProjectConfiguration": {
    "TestMode": {
      "Id": "production",
      "Name": "Production Test",
      "Icon": "factory",
      "Description": "Default production test flow",
      "DefaultTimeout": 300000,
      "EnableParallel": true,
      "MaxRetries": 2
    },
    "TestProject": {
      "Id": "generic_production_test",
      "Name": "Generic Production Test",
      "Description": "Connectivity and device verification flow",
      "Enabled": true,
      "Steps": [
        {
          "Id": "step_001",
          "Name": "Local Network Check",
          "Description": "Verify the local TCP/IP stack",
          "Order": 1,
          "Enabled": true,
          "Target": "station",
          "Type": "custom",
          "Command": "ping -n 2 127.0.0.1",
          "Expected": "contains:TTL=",
          "Timeout": 10000,
          "Delay": 0,
          "RetryCount": 1,
          "Channel": "cmd"
        },
        {
          "Id": "step_002",
          "Name": "Software Version Check",
          "Description": "Read the DUT software version over serial",
          "Order": 2,
          "Enabled": true,
          "Target": "dut",
          "Type": "serial",
          "Command": "system_manager version",
          "Expected": "contains:SW_VERSION:V1.0",
          "Timeout": 5000,
          "Delay": 500,
          "RetryCount": 1,
          "Channel": "serial",
          "StoreResultAs": "software_version"
        },
        {
          "Id": "step_003",
          "Name": "MAC Address Check",
          "Description": "Read the DUT MAC address",
          "Order": 3,
          "Enabled": true,
          "Target": "dut",
          "Type": "serial",
          "Command": "mac",
          "Expected": "regex:(?i)^[0-9a-f]{2}([:-][0-9a-f]{2}){5}$",
          "Timeout": 5000,
          "Delay": 500,
          "RetryCount": 1,
          "Channel": "serial"
        },
        {
          "Id": "step_004",
          "Name": "Factory Self Test",
          "Description": "Run the DUT factory self-test",
          "Order": 4,
          "Enabled": true,
          "Target": "dut",
          "Type": "serial",
          "Command": "system_manager factory_test",
          "Expected": "contains:test pass",
          "Timeout": 25000,
          "Delay": 1000,
          "RetryCount": 1,
          "Channel": "serial",
          "ConditionExpression": "exists:software_version"
        }
      ]
    }
  }
}
