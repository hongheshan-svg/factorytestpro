<Window x:Class="UTF.UI.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sign in - Universal Test Framework"
        Width="420" Height="430"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <Grid Background="#F0F2F5">
        <Border Width="340" Padding="28" Background="White" BorderBrush="#CFD8DC"
                BorderThickness="1" CornerRadius="6" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock x:Name="TitleText" Text="Test platform sign in" FontSize="22" FontWeight="SemiBold"
                           Foreground="#212121" Margin="0,0,0,8"/>
                <TextBlock x:Name="SubtitleText" Text="Use your workstation account to continue" Foreground="#546E7A"
                           Margin="0,0,0,22"/>

                <TextBlock Text="Username" Margin="0,0,0,5"/>
                <TextBox x:Name="UsernameTextBox" Height="34" MaxLength="64"/>

                <TextBlock Text="Password" Margin="0,14,0,5"/>
                <PasswordBox x:Name="PasswordBox" Height="34" MaxLength="256"/>

                <StackPanel x:Name="ConfirmPanel" Visibility="Collapsed">
                    <TextBlock Text="Confirm password" Margin="0,14,0,5"/>
                    <PasswordBox x:Name="ConfirmPasswordBox" Height="34" MaxLength="256"/>
                    <TextBlock Text="Use at least 12 characters" Foreground="#546E7A" FontSize="11" Margin="0,5,0,0"/>
                </StackPanel>

                <TextBlock x:Name="MessageText" Foreground="#C62828" TextWrapping="Wrap" MinHeight="20"
                           Margin="0,14,0,0"/>
                <Button x:Name="SubmitButton" Content="Sign in" Height="38" Margin="0,8,0,0"
                        IsDefault="True" Click="Submit_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
