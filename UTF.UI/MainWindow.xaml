<Window x:Class="UTF.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:UTF.UI"
        xmlns:converters="clr-namespace:UTF.UI.Converters"
        xmlns:loc="clr-namespace:UTF.UI.Localization"
        xmlns:views="clr-namespace:UTF.UI.Views"
        Title="通用自动化测试平台" 
        Height="900" Width="1400" WindowStartupLocation="CenterScreen">
    
    <!-- 资源字典 -->
    <Window.Resources>
        <!-- 转换器 -->
        <local:TestResultToColorConverter x:Key="ResultToColorConverter"/>
        <local:TestResultToBackgroundConverter x:Key="ResultToBackgroundConverter"/>
        <local:TestStatusToColorConverter x:Key="StatusToColorConverter"/>
        <local:DutCountToColorConverter x:Key="DutCountToColorConverter"/>
        <converters:LogLevelToColorConverter x:Key="LogLevelToColorConverter"/>
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        
        <!-- 测试结果样式 -->
        <Style x:Key="PassResultStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Green"/>
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        
        <Style x:Key="FailResultStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Red"/>
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        
        <Style x:Key="RunningResultStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Orange"/>
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        
        <Style x:Key="WaitingResultStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>
    
    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>
        
        <!-- 菜单栏 — engineering items Visibility bound to ShowEngineeringMenus (UiProfile + role) -->
        <Menu Grid.Row="0" Background="White" BorderBrush="#FFE0E0E0" BorderThickness="0,0,0,1">
            <MenuItem Header="文件(_F)">
                <MenuItem x:Name="ImportConfigFileMenuItem" Header="导入配置(_I)" Command="{Binding ImportConfigCommand}"
                          IsEnabled="{Binding CanImportConfig}"
                          Visibility="{Binding ShowEngineeringMenus, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <Separator Visibility="{Binding ShowEngineeringMenus, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <MenuItem Header="退出(_X)" Command="{Binding ExitAppCommand}"/>
            </MenuItem>
            <MenuItem x:Name="ConfigurationMenuItem" Header="配置(_C)"
                      Visibility="{Binding ShowEngineeringMenus, Converter={StaticResource BooleanToVisibilityConverter}}">
                <MenuItem x:Name="ConfigCenterMenuItem" Header="配置管理中心(_M)" Command="{Binding OpenConfigurationCenterCommand}"
                          IsEnabled="{Binding CanConfigureSystem}"/>
                <MenuItem x:Name="TemplatePackPickerMenuItem" Header="选择工艺包/模板…(_T)" Command="{Binding OpenTemplatePackPickerCommand}"
                          IsEnabled="{Binding CanOpenTemplatePackPicker}"/>
                <Separator/>
                <MenuItem x:Name="ImportConfigMenuItem" Header="导入配置(_I)" Command="{Binding ImportConfigCommand}"
                          IsEnabled="{Binding CanImportConfig}"/>
            </MenuItem>
            <MenuItem Header="工具(_T)">
                <MenuItem x:Name="QuickCreateMenuItem" Header="🚀 快速创建测试(_Q)" Command="{Binding OpenQuickTestWizardCommand}" FontWeight="SemiBold"
                          IsEnabled="{Binding CanManageTestPlans}"
                          Visibility="{Binding ShowEngineeringMenus, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <Separator Visibility="{Binding ShowEngineeringMenus, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <MenuItem x:Name="PluginManagerMenuItem" Header="插件管理(_P)" Command="{Binding OpenPluginManagerCommand}"
                          IsEnabled="{Binding CanConfigureSystem}"
                          Visibility="{Binding ShowEngineeringMenus, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <MenuItem x:Name="DeviceManagerMenuItem" Header="设备管理(_D)" Command="{Binding OpenDeviceManagerCommand}"
                          IsEnabled="{Binding CanManageDevices}"/>
                <MenuItem x:Name="UserManagerMenuItem" Header="用户管理(_U)" Command="{Binding OpenUserManagerCommand}"
                          IsEnabled="{Binding CanManageUsers}"/>
                <Separator Visibility="{Binding ShowEngineeringMenus, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <MenuItem x:Name="TestPlanEditorMenuItem" Header="测试计划编辑器(_E)" Command="{Binding OpenTestPlanEditorCommand}"
                          IsEnabled="{Binding CanManageTestPlans}"
                          Visibility="{Binding ShowEngineeringMenus, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <MenuItem x:Name="ToolsConfigCenterMenuItem" Header="配置管理中心(_C)" Command="{Binding OpenConfigurationCenterCommand}"
                          IsEnabled="{Binding CanConfigureSystem}"
                          Visibility="{Binding ShowEngineeringMenus, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </MenuItem>
            <MenuItem Header="视图(_V)">
                <MenuItem Header="工作台模式" IsEnabled="False" FontWeight="SemiBold"/>
                <MenuItem Header="多DUT看板" Command="{Binding SetWorkbenchModeCommand}" CommandParameter="MultiDutBoard"/>
                <MenuItem Header="单工位" Command="{Binding SetWorkbenchModeCommand}" CommandParameter="SingleStation"/>
                <MenuItem Header="扫码测试" Command="{Binding SetWorkbenchModeCommand}" CommandParameter="ScanToTest"/>
                <MenuItem Header="仪器台" Command="{Binding SetWorkbenchModeCommand}" CommandParameter="InstrumentBench"/>
                <Separator/>
                <MenuItem Header="恢复配置模式" Command="{Binding ResetWorkbenchModeFromConfigCommand}"/>
            </MenuItem>
            <MenuItem Header="账户(_A)">
                <MenuItem Header="退出登录" Command="{Binding LogoutCommand}"/>
            </MenuItem>
        </Menu>
        
        <!-- 标题栏 -->
        <Border Grid.Row="1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#1565C0" Offset="0"/>
                    <GradientStop Color="#0D47A1" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid Margin="20,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <TextBlock Text="⚡" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="通用自动化测试平台" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    <Border Background="#1976D2" CornerRadius="12" Padding="10,3" Margin="20,0,0,0" VerticalAlignment="Center">
                        <TextBlock Name="UserInfoText" Text="用户: 未登录" Foreground="White" FontSize="11"/>
                    </Border>
                    <Border Background="#1976D2" CornerRadius="12" Padding="10,3" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock Name="StationInfoText" Text="站台: 测试站01" Foreground="White" FontSize="11"/>
                    </Border>
                    <Border Background="#FF8F00" CornerRadius="12" Padding="10,3" Margin="8,0,0,0" VerticalAlignment="Center"
                            Visibility="{Binding ShowOperatorChrome, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="操作员模式" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Name="ProductModelText" Text="{Binding ProductModelText}" Foreground="#FFE082" FontSize="15" FontWeight="SemiBold"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- 工具栏 -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Margin="16,0" VerticalAlignment="Center">
                <Button Name="StartTestBtn" Content="{Binding StartTestButtonText}" Padding="18,9" FontSize="13" FontWeight="SemiBold"
                        Background="{StaticResource SuccessBrush}" Command="{Binding StartTestCommand}"
                        IsEnabled="{Binding IsStartTestEnabled}"/>
                <Button Name="StopTestBtn" Content="⏹  停止测试" Padding="18,9" FontSize="13" FontWeight="SemiBold"
                        Background="{StaticResource WarnBrush}" Margin="8,0,0,0" Command="{Binding StopTestCommand}"
                        IsEnabled="{Binding CanStopTest}"/>
                <Rectangle Width="1" Fill="#E0E0E0" Margin="16,8"/>
                <Button x:Name="QuickCreateButton" Content="🚀 快速创建测试" Padding="14,8" FontSize="12" FontWeight="SemiBold"
                        Background="#007ACC" Foreground="White" BorderThickness="0" Cursor="Hand"
                        Command="{Binding OpenQuickTestWizardCommand}" ToolTip="向导式快速创建测试配置"
                        IsEnabled="{Binding CanManageTestPlans}"
                        Visibility="{Binding ShowEngineeringMenus, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <Rectangle Width="1" Fill="#E0E0E0" Margin="16,8"
                           Visibility="{Binding ShowEngineeringMenus, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <TextBlock Text="状态:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,6,0"/>
                <Border VerticalAlignment="Center" Background="#E8F5E9" CornerRadius="10" Padding="10,3">
                    <TextBlock Name="StatusText" Text="{Binding StatusText}" Foreground="#2E7D32" FontWeight="SemiBold" FontSize="12"/>
                </Border>
                <Rectangle Width="1" Fill="#E0E0E0" Margin="16,8"/>
                <!-- 步骤预览 Badge -->
                <Border x:Name="StepPreviewBorder" Background="#F0F4FF" CornerRadius="6"
                        Padding="8,4" VerticalAlignment="Center"
                        Cursor="Hand" MouseLeftButtonUp="ToggleStepPreview_Click">
                    <Border.ToolTip>
                        <ToolTip x:Name="StepPreviewTooltip" Placement="Bottom">
                            <StackPanel x:Name="StepPreviewPanel" MinWidth="260" MaxHeight="300">
                                <TextBlock Text="测试步骤序列" FontWeight="SemiBold" FontSize="12"
                                           Foreground="#1565C0" Margin="0,0,0,6"/>
                                <ItemsControl x:Name="StepPreviewList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontSize="11" Margin="0,1"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ToolTip>
                    </Border.ToolTip>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📋 测试步骤:" FontSize="11" Foreground="#1565C0" Margin="0,0,6,0"/>
                        <TextBlock x:Name="StepCountText" Text="0步" FontSize="11" FontWeight="Bold" Foreground="#1565C0"/>
                    </StackPanel>
                </Border>
                <Rectangle Width="1" Fill="#E0E0E0" Margin="16,8"/>
                <!-- 工作台模式切换（会话级，不写配置） -->
                <TextBlock Text="工作台模式:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,6,0"/>
                <ComboBox Width="140" VerticalAlignment="Center"
                          ItemsSource="{Binding AvailableWorkbenchModes}"
                          SelectedItem="{Binding SelectedWorkbenchModeOption, Mode=TwoWay}"
                          DisplayMemberPath="DisplayName"/>
                <TextBlock Text="{Binding WorkbenchModeDisplay}" VerticalAlignment="Center"
                           Foreground="#1565C0" FontSize="11" FontWeight="SemiBold" Margin="8,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- 配置校验横幅：有错误时显示，非模态，不阻断其它操作 -->
        <Border Grid.Row="3" Padding="14,8" BorderThickness="0,0,0,1" BorderBrush="#E0A800"
                Background="#FFF3CD"
                Visibility="{Binding HasConfigErrors, Converter={StaticResource BoolToVisConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="⚠" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#856404"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="配置校验未通过 — 启动测试已禁用，请在配置中心修复后重试。"
                               FontWeight="SemiBold" FontSize="12" Foreground="#856404"/>
                    <TextBlock Text="{Binding ConfigValidationSummary}" FontSize="11" Foreground="#6D5200"
                               TextWrapping="Wrap" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- WorkbenchHost: multi-mode main content (P5); row 4 after validation banner -->
        <Grid x:Name="WorkbenchHost" Grid.Row="4" Margin="10">
            <views:MultiDutBoardView x:Name="MultiDutBoardPanel"
                                     Visibility="{Binding IsMultiDutBoardMode, Converter={StaticResource BoolToVis}}"/>
            <views:SingleStationView x:Name="SingleStationPanel"
                                     Visibility="{Binding IsSingleStationMode, Converter={StaticResource BoolToVis}}"/>
            <views:ScanToTestView x:Name="ScanToTestPanel"
                                  Visibility="{Binding IsScanToTestMode, Converter={StaticResource BoolToVis}}"/>
            <views:InstrumentBenchView x:Name="InstrumentBenchPanel"
                                       Visibility="{Binding IsInstrumentBenchMode, Converter={StaticResource BoolToVis}}"/>
        </Grid>
        
        <!-- 状态栏 -->
        <Border Grid.Row="5" Background="#0D47A1">
            <Grid Margin="5,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- 左侧系统状态 -->
                <TextBlock Name="StatusTextFooter" Text="{Binding StatusTextFooter}" Foreground="White" VerticalAlignment="Center" FontSize="11" TextTrimming="CharacterEllipsis"/>

                <!-- UiProfile mode badge -->
                <Border Grid.Column="1" Background="#1565C0" CornerRadius="8" Padding="8,2" Margin="10,0,0,0"
                        VerticalAlignment="Center" ToolTip="当前 UI 配置模式 (UiProfile.Mode)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="模式:" Foreground="#90CAF9" FontSize="10" Margin="0,0,4,0"/>
                        <TextBlock Text="{Binding UiModeDisplayName}" Foreground="White" FontSize="10" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>

                <!-- DUT测试统计 (支持千万级数字显示；UnitLabel 来自 UiProfile) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0">
                    <TextBlock Text="{Binding UnitStatsLabel}" Foreground="#B0B0B0" FontSize="11" Margin="0,0,12,0"/>

                    <TextBlock Text="总:" Foreground="#B0B0B0" FontSize="11" Margin="0,0,2,0"/>
                    <TextBlock Name="TotalDUTsText" Text="{Binding TotalDuts}" Foreground="White" FontWeight="Bold" FontFamily="Consolas" FontSize="11" MinWidth="55" TextAlignment="Right"/>

                    <TextBlock Text="|" Foreground="#B0B0B0" FontSize="11" Margin="6,0"/>
                    <TextBlock Text="测试中:" Foreground="#F39C12" FontSize="11" Margin="0,0,2,0"/>
                    <TextBlock Name="RunningDUTsText" Text="{Binding RunningDuts}" Foreground="#F39C12" FontWeight="Bold" FontFamily="Consolas" FontSize="11" MinWidth="55" TextAlignment="Right"/>

                    <TextBlock Text="|" Foreground="#B0B0B0" FontSize="11" Margin="6,0"/>
                    <TextBlock Text="等待:" Foreground="#6C757D" FontSize="11" Margin="0,0,2,0"/>
                    <TextBlock Name="WaitingDUTsText" Text="{Binding WaitingDuts}" Foreground="#B0B0B0" FontWeight="Bold" FontFamily="Consolas" FontSize="11" MinWidth="55" TextAlignment="Right"/>

                    <TextBlock Text="|" Foreground="#B0B0B0" FontSize="11" Margin="6,0"/>
                    <TextBlock Text="✅合格:" Foreground="#28A745" FontSize="11" Margin="0,0,2,0"/>
                    <TextBlock Name="PassedDUTsText" Text="{Binding PassedDuts}" Foreground="#28A745" FontWeight="Bold" FontFamily="Consolas" FontSize="11" MinWidth="55" TextAlignment="Right"/>

                    <TextBlock Text="|" Foreground="#B0B0B0" FontSize="11" Margin="6,0"/>
                    <TextBlock Text="❌不合格:" Foreground="#DC3545" FontSize="11" Margin="0,0,2,0"/>
                    <TextBlock Name="FailedDUTsText" Text="{Binding FailedDuts}" Foreground="#DC3545" FontWeight="Bold" FontFamily="Consolas" FontSize="11" MinWidth="55" TextAlignment="Right"/>

                    <TextBlock Text="|" Foreground="#B0B0B0" FontSize="11" Margin="6,0"/>
                    <TextBlock Text="通过率:" Foreground="#007BFF" FontSize="11" Margin="0,0,2,0"/>
                    <TextBlock Name="PassRateMainText" Text="{Binding PassRateText}" Foreground="#007BFF" FontWeight="Bold" FontFamily="Consolas" FontSize="11" MinWidth="45" TextAlignment="Right"/>
                </StackPanel>
                
                <!-- 测试时间统计 -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0">
                    <TextBlock Text="测试时间:" Foreground="#B0B0B0" FontSize="11" Margin="0,0,4,0"/>
                    <TextBlock Name="TestDurationText" Text="00:00:00" Foreground="White" FontWeight="Bold" FontSize="11"/>
                    <TextBlock Text="|" Foreground="#B0B0B0" FontSize="11" Margin="8,0"/>
                    <TextBlock Text="总测试:" Foreground="#B0B0B0" FontSize="11" Margin="0,0,4,0"/>
                    <TextBlock Name="TotalTestsText" Text="0" Foreground="White" FontWeight="Bold" FontSize="11"/>
                    <TextBlock Text="次" Foreground="#B0B0B0" FontSize="11" Margin="2,0,0,0"/>
                </StackPanel>
                
                <!-- 插件状态 + 当前时间 -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="PluginStatusBorder" Background="#27AE60" CornerRadius="10"
                            Padding="8,2" Margin="0,0,10,0" Cursor="Hand"
                            MouseLeftButtonUp="PluginStatus_Click"
                            ToolTip="点击查看插件管理"
                            Visibility="{Binding ShowEngineeringMenus, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔌" FontSize="11" Margin="0,0,4,0"/>
                            <TextBlock x:Name="PluginStatusText" Text="插件: 加载中..."
                                       Foreground="White" FontSize="11" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Name="DateTimeText" Text="{Binding DateTimeText}" Foreground="White" FontSize="11" Margin="0,0,5,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
